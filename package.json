{
  "name": "life-in-the-uk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx server/index.ts\"",
    "build": "tsc -b && vite build && npm run build:server",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "questions:validate": "tsx scripts/validate-questions.ts",
    "lessons:validate": "tsx scripts/validate-lessons.ts",
    "questions:stats": "tsx scripts/question-stats.ts",
    "typecheck": "tsc -b --noEmit",
    "questions:generate": "tsx scripts/generate.ts",
    "questions:merge": "tsx scripts/merge-batch.ts",
    "dev:api": "tsx watch server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-server/index.js --external:pg --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" && node -e \"require('fs').copyFileSync('server/schema.sql','dist-server/schema.sql')\""
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "hono": "^4.6.14",
    "lucide-react": "^1.34.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
